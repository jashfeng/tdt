// context7 验证：标记点击检测已内置于 initMap 的单一 OnMapClickListener 中（Priority 1 先检测标记，Priority 2 触发地图点击，二者互斥）
// 此处仅更新回调引用；不再注册额外监听器（重复注册会导致双重触发或事件被首个监听器拦截）
@UTSJS.keepAlive
export function setMarkerClickCallback(callback: MarkerClickCallback): void {
    markerClickCallback = callback
    // 标记点击检测逻辑已合并到 initMap 的 OnMapClickListener 中（见 initMap 中的 Priority 1 检查）。
    // 闭包通过模块级变量 markerClickCallback 和 markerList 访问最新引用，
    // 因此用户在不同时机调用 setMarkerClickCallback 均能生效。
}

