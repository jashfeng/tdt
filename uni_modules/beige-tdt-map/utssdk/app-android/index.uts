// v1.7.0: 标记聚合 + 热力图（context7: maplibre-native issue #3519 验证包名与用法，
// MapLibre Android 保留 com.mapbox.geojson 包名）
import { Expression } from "org.maplibre.android.style.expressions"
import { GeoJsonSource, GeoJsonOptions } from "org.maplibre.android.style.sources"
import { CircleLayer, SymbolLayer, HeatmapLayer } from "org.maplibre.android.style.layers"
import { FeatureCollection, Feature, Point } from "com.mapbox.geojson"
import { JsonObject } from "com.google.gson"
